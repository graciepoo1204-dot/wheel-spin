<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#13141f">
<title>Boredom Roulette 🎡</title>
<style>
:root {
  --bg: #13141f;
  --bg2: #1b1d2d;
  --card: #222538;
  --card2: #2d314d;
  --text: #ffffff;
  --muted: #a6adce;
  --accent: #00f0ff;
  --accent2: #ff007f;
  --accent3: #39ff14;
  --danger: #ff4757;
  --wheel1: #00f0ff;
  --wheel2: #ff007f;
  --wheel3: #39ff14;
  --wheel4: #ffaa00;
  --wheel5: #9d00ff;
  --wheel6: #00ffaa;
  --wheel7: #ff0055;
  --wheel8: #70ff00;
  --wheel9: #0051ff;
  --wheel10: #ffea00;
  --bg-gradient: linear-gradient(135deg, #0f172a, #3b0764, #1e3a8a, #0f172a);
  --orb1: rgba(57,255,20,0.3);
  --orb2: rgba(0,240,255,0.35);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg-gradient);
  background-size: 400% 400%;
  animation: moveGradient 7s ease infinite;
  background-attachment: fixed;
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  overflow-x: hidden;
  transition: color .4s ease;
  position: relative;
}
@keyframes moveGradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
body::before, body::after {
  content: "";
  position: absolute;
  width: 380px; height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--orb1), transparent 70%);
  z-index: -1;
  animation: floatOrb 9s infinite alternate ease-in-out;
  pointer-events: none;
}
body::after {
  width: 480px; height: 480px;
  right: -60px; bottom: 5vh;
  background: radial-gradient(circle, var(--orb2), transparent 70%);
  animation-duration: 11s;
  animation-direction: alternate-reverse;
}
@keyframes floatOrb {
  0% { transform: translateY(0) scale(1); }
  100% { transform: translateY(-90px) scale(1.18); }
}

button, select, input { font: inherit; }
button { cursor: pointer; }
.app { width: min(100%, 850px); margin: auto; padding: 16px; position: relative; z-index: 2; }
header { text-align: center; padding: 18px 8px 12px; }
.logo {
  font-size: clamp(2rem, 8vw, 3.4rem);
  font-weight: 900;
  letter-spacing: -2px;
  text-shadow: 0 0 18px rgba(0,240,255,.35);
}
.tagline { color: var(--muted); margin-top: 5px; font-size: .95rem; }
.badge-group { display: flex; gap: 8px; justify-content: center; align-items: center; margin-top: 10px; }
.badge {
  display: inline-block;
  padding: 7px 12px;
  border-radius: 999px;
  background: var(--card2);
  color: var(--accent);
  font-size: .75rem;
  font-weight: 800;
  box-shadow: 0 0 0 1px rgba(0,0,0,.08);
}
.streak-badge {
  background: rgba(0, 240, 255, 0.15);
  color: var(--accent);
  border: 1px solid var(--accent);
}
nav { display: flex; gap: 7px; margin: 15px 0; }
.nav-btn {
  flex: 1;
  border: 0;
  border-radius: 12px;
  padding: 11px 7px;
  background: var(--card);
  color: var(--muted);
  font-weight: 800;
  transition: all .2s ease;
  box-shadow: 0 4px 12px rgba(0,0,0,.08);
}
.nav-btn.active {
  background: var(--accent);
  color: var(--bg);
  box-shadow: 0 0 16px rgba(0,240,255,.35);
}
.section { display: none; }
.section.active { display: block; }
.card {
  background: var(--card);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 22px;
  padding: 18px;
  margin-bottom: 15px;
  box-shadow: 0 14px 35px rgba(0,0,0,.25);
  transition: background .4s ease, border .4s ease, color .4s ease;
}
.card-title { font-size: 1.2rem; font-weight: 900; margin-bottom: 5px; }
.card-subtitle { color: var(--muted); font-size: .88rem; margin-bottom: 15px; }
.hint { color: var(--accent); font-size: .78rem; font-weight: 800; margin: -6px 0 12px; }
.quick-spin {
  width: 100%;
  border: 0;
  border-radius: 15px;
  padding: 14px;
  margin-bottom: 15px;
  background: var(--accent);
  color: var(--bg);
  font-weight: 1000;
  font-size: 1rem;
  box-shadow: 0 7px 0 rgba(0,0,0,.2);
  transition: transform .1s ease, filter .2s ease;
}
.quick-spin:active { transform: translateY(4px); box-shadow: 0 3px 0 rgba(0,0,0,.2); }
.choice-section { margin-bottom: 20px; }
.choice-heading { font-size: 1rem; font-weight: 900; margin-bottom: 9px; }
.choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.choice {
  border: 2px solid transparent;
  background: var(--card2);
  color: var(--text);
  border-radius: 14px;
  padding: 12px 8px;
  text-align: left;
  transition: all .18s ease;
  position: relative;
}
.choice:hover { transform: translateY(-2px); }
.choice.selected {
  border-color: var(--accent);
  background: rgba(0,240,255,.2);
  box-shadow: 0 0 0 2px rgba(0,240,255,.25);
}
.choice.selected::after {
  content: "✓";
  position: absolute;
  top: 6px;
  right: 8px;
  font-size: .75rem;
  font-weight: 900;
  color: var(--accent);
}
.choice-icon { font-size: 1.3rem; display: block; margin-bottom: 4px; }
.choice-name { font-weight: 900; font-size: .86rem; }
.choice-description { display: block; color: var(--muted); font-size: .7rem; margin-top: 3px; }
.spin-main {
  width: 100%;
  border: 0;
  border-radius: 17px;
  padding: 17px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #ffffff;
  font-size: 1.15rem;
  font-weight: 1000;
  box-shadow: 0 8px 0 rgba(0,0,0,.25);
  transition: transform .1s ease;
}
.spin-main:active { transform: translateY(4px); box-shadow: 0 4px 0 rgba(0,0,0,.25); }
.spin-main:disabled, .quick-spin:disabled { opacity: .55; cursor: not-allowed; }
.wheel-card { text-align: center; overflow: hidden; }
.wheel-wrap {
  width: min(88vw, 420px);
  aspect-ratio: 1;
  margin: 15px auto 10px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pointer {
  position: absolute;
  z-index: 10;
  top: -3px;
  left: 50%;
  transform: translateX(-50%);
  width: 0; height: 0;
  border-left: 17px solid transparent;
  border-right: 17px solid transparent;
  border-top: 37px solid var(--text);
  filter: drop-shadow(0 4px 3px rgba(0,0,0,.35));
}
.wheel {
  width: 100%; height: 100%;
  border-radius: 50%;
  border: 9px solid var(--text);
  position: relative;
  background: conic-gradient(
    var(--wheel1) 0deg 36deg,
    var(--wheel2) 36deg 72deg,
    var(--wheel3) 72deg 108deg,
    var(--wheel4) 108deg 144deg,
    var(--wheel5) 144deg 180deg,
    var(--wheel6) 180deg 216deg,
    var(--wheel7) 216deg 252deg,
    var(--wheel8) 252deg 288deg,
    var(--wheel9) 288deg 324deg,
    var(--wheel10) 324deg 360deg
  );
  box-shadow: 0 0 0 5px rgba(0,0,0,.2), 0 18px 35px rgba(0,0,0,.3);
  transition: transform 3s cubic-bezier(.12,.72,.08,1);
  transform: rotate(0deg);
}
.wheel::after {
  content: "";
  position: absolute;
  inset: 9%;
  border-radius: 50%;
  border: 3px dashed rgba(255,255,255,.7);
  pointer-events: none;
}
.wheel-label {
  position: absolute;
  left: 50%; top: 50%;
  width: 75px;
  margin-left: -37.5px;
  margin-top: -11px;
  text-align: center;
  color: #13141f;
  font-size: .68rem;
  font-weight: 1000;
  text-shadow: 0 1px rgba(255,255,255,.25);
  pointer-events: none;
}
.center-spin {
  position: absolute;
  z-index: 5;
  width: 85px; height: 85px;
  border-radius: 50%;
  border: 6px solid var(--text);
  background: var(--bg);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .95rem;
  font-weight: 1000;
  box-shadow: 0 7px 15px rgba(0,0,0,.3);
}
.wheel-status { color: var(--muted); min-height: 22px; font-size: .85rem; font-weight: 700; margin-top: 8px; }
.result { display: none; text-align: center; animation: pop .45s ease; }
.result.show { display: block; }
.result-eyebrow {
  color: var(--accent);
  font-size: .8rem;
  font-weight: 1000;
  text-transform: uppercase;
  letter-spacing: 1px;
}
.result-character { font-size: 5rem; margin: 10px; animation: bob 1.8s ease-in-out infinite; }
.result-title { font-size: clamp(1.5rem, 6vw, 2.2rem); font-weight: 1000; margin: 5px 0 8px; }
.result-desc { color: var(--muted); line-height: 1.5; max-width: 600px; margin: auto; }
.result-category {
  display: inline-block;
  margin-top: 13px;
  padding: 7px 11px;
  border-radius: 999px;
  background: var(--card2);
  color: var(--accent3);
  font-weight: 900;
  font-size: .75rem;
}
.reel-box {
  background: var(--card2);
  border-radius: 16px;
  padding: 12px 16px;
  margin-top: 16px;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px dashed rgba(255,255,255,.25);
}
.reel-icon { font-size: 2rem; }
.reel-info { flex: 1; }
.reel-label-small { font-size: .7rem; font-weight: 900; color: var(--accent2); text-transform: uppercase; letter-spacing: .5px; }
.reel-title { font-size: .9rem; font-weight: 900; margin-top: 2px; }
.reel-btn {
  background: var(--accent);
  color: var(--bg);
  border: 0;
  padding: 8px 12px;
  border-radius: 10px;
  font-weight: 900;
  font-size: .78rem;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 4px 10px rgba(0,0,0,.2);
}
.result-buttons { display: flex; gap: 9px; margin-top: 17px; }
.result-buttons button { flex: 1; border: 0; border-radius: 13px; padding: 12px; font-weight: 900; }
.again { background: var(--accent); color: #13141f; }
.save { background: var(--card2); color: var(--text); }
.save.saved { background: var(--accent3); color: #13141f; }
.saved-empty { text-align: center; color: var(--muted); padding: 35px 10px; }
.saved-item {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 13px;
  background: var(--card2);
  border-radius: 15px;
  margin-bottom: 8px;
}
.saved-emoji { font-size: 2rem; }
.saved-info { flex: 1; }
.saved-title { font-weight: 900; }
.saved-desc { color: var(--muted); font-size: .78rem; margin-top: 3px; }
.delete-save { border: 0; background: transparent; color: var(--danger); font-size: 1.2rem; }
.about-list { padding-left: 20px; color: var(--muted); line-height: 1.7; }
.about-list strong { color: var(--text); }

.theme-toggle {
  position: fixed;
  right: 15px; bottom: 15px;
  z-index: 50;
  width: 56px; height: 56px;
  border-radius: 50%;
  border: 3px solid rgba(255,255,255,.35);
  background: var(--accent);
  color: #13141f;
  font-size: 1.5rem;
  box-shadow: 0 8px 25px rgba(0,0,0,.35);
  transition: transform .2s ease;
}
.theme-toggle:hover { transform: scale(1.08); }
.theme-panel {
  display: none;
  position: fixed;
  z-index: 49;
  right: 15px; bottom: 82px;
  width: min(310px, calc(100vw - 30px));
  background: var(--card);
  border: 2px solid rgba(255,255,255,.25);
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 15px 45px rgba(0,0,0,.35);
}
.theme-panel.open { display: block; animation: pop .22s ease; }
.theme-panel h3 { margin: 3px 4px 12px; font-size: 1rem; }
.theme-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.theme-btn {
  border: 2px solid transparent;
  border-radius: 12px;
  padding: 11px 8px;
  background: var(--card2);
  color: var(--text);
  font-size: .8rem;
  font-weight: 800;
  text-align: left;
  transition: transform .15s ease;
}
.theme-btn:hover { transform: translateY(-2px); }
.theme-btn.active-theme {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(0,240,255,.3);
  background: rgba(0,240,255,.2);
}
.confetti {
  position: fixed;
  z-index: 100;
  width: 9px; height: 15px;
  pointer-events: none;
  animation: fall 1.8s linear forwards;
}
@keyframes pop {
  from { opacity: 0; transform: scale(.94); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes bob {
  0%,100% { transform: translateY(0) rotate(-3deg); }
  50% { transform: translateY(-9px) rotate(3deg); }
}
@keyframes fall {
  from { transform: translateY(-30px) rotate(0deg); opacity: 1; }
  to { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

body.theme-rainbow .choice-section:nth-of-type(1) .choice-heading { color: #ff0055; text-shadow: 0 0 10px rgba(255,0,85,0.4); }
body.theme-rainbow .choice-section:nth-of-type(2) .choice-heading { color: #ffaa00; text-shadow: 0 0 10px rgba(255,170,0,0.4); }
body.theme-rainbow .choice-section:nth-of-type(3) .choice-heading { color: #00ff66; text-shadow: 0 0 10px rgba(0,255,102,0.4); }

body.theme-rainbow .choice[data-group="brain"]:nth-child(1) { background: rgba(255, 0, 85, 0.25); border-color: #ff0055; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(2) { background: rgba(255, 128, 0, 0.25); border-color: #ff8000; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(3) { background: rgba(255, 230, 0, 0.25); border-color: #ffe600; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(4) { background: rgba(0, 230, 115, 0.25); border-color: #00e673; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(5) { background: rgba(0, 204, 255, 0.25); border-color: #00ccff; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(6) { background: rgba(0, 102, 255, 0.25); border-color: #0066ff; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(7) { background: rgba(153, 0, 255, 0.25); border-color: #9900ff; }
body.theme-rainbow .choice[data-group="brain"]:nth-child(8) { background: rgba(255, 0, 204, 0.25); border-color: #ff00cc; }

body.theme-rainbow .choice[data-group="situation"]:nth-child(odd) { background: rgba(0, 240, 255, 0.2); border-color: #00f0ff; }
body.theme-rainbow .choice[data-group="situation"]:nth-child(even) { background: rgba(255, 0, 170, 0.2); border-color: #ff00aa; }

@media (min-width: 600px) {
  .choice-grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="logo">🎡 Boredom Roulette</div>
  <div class="tagline">Because staring at the wall isn't an activity.</div>
  <div class="badge-group">
    <div class="badge">SPIN YOUR WAY OUT</div>
    <div class="badge streak-badge" id="streakBadge">🔥 0 SPINS</div>
  </div>
</header>
<nav>
  <button class="nav-btn active" onclick="showSection('roulette', this)">🎡 Roulette</button>
  <button class="nav-btn" onclick="showSection('saved', this)">⭐ Saved</button>
  <button class="nav-btn" onclick="showSection('about', this)">ℹ️ About</button>
</nav>

<section id="roulette" class="section active">
<button class="quick-spin" onclick="quickSpin()">⚡ I DON'T WANNA THINK — JUST SPIN</button>

<div class="card">
  <div class="card-title">Let's figure out your boredom.</div>
  <div class="card-subtitle">Pick what fits right now. You can select multiple options in each group.</div>
  <div class="hint">Tip: tap again to deselect. At least one option per group stays selected.</div>

  <div class="choice-section">
    <div class="choice-heading">🧠 How's your brain?</div>
    <div class="choice-grid">
      <button class="choice selected" data-group="brain" data-value="bored" onclick="selectChoice(this)">
        <span class="choice-icon">🥱</span><span class="choice-name">Bored</span><span class="choice-description">Need something</span>
      </button>
      <button class="choice" data-group="brain" data-value="stim" onclick="selectChoice(this)">
        <span class="choice-icon">⚡</span><span class="choice-name">Stim</span><span class="choice-description">Give me MORE</span>
      </button>
      <button class="choice" data-group="brain" data-value="chill" onclick="selectChoice(this)">
        <span class="choice-icon">😌</span><span class="choice-name">Chill</span><span class="choice-description">Low pressure</span>
      </button>
      <button class="choice" data-group="brain" data-value="creative" onclick="selectChoice(this)">
        <span class="choice-icon">🎨</span><span class="choice-name">Creative</span><span class="choice-description">Make something</span>
      </button>
      <button class="choice" data-group="brain" data-value="curious" onclick="selectChoice(this)">
        <span class="choice-icon">🧠</span><span class="choice-name">Curious</span><span class="choice-description">Teach me</span>
      </button>
      <button class="choice" data-group="brain" data-value="nostalgic" onclick="selectChoice(this)">
        <span class="choice-icon">🥹</span><span class="choice-name">Nostalgic</span><span class="choice-description">Take me back</span>
      </button>
      <button class="choice" data-group="brain" data-value="social" onclick="selectChoice(this)">
        <span class="choice-icon">🗣️</span><span class="choice-name">Social</span><span class="choice-description">People!</span>
      </button>
      <button class="choice" data-group="brain" data-value="frustrated" onclick="selectChoice(this)">
        <span class="choice-icon">😤</span><span class="choice-name">Frustrated</span><span class="choice-description">Burn it off</span>
      </button>
    </div>
  </div>

  <div class="choice-section">
    <div class="choice-heading">📍 What's your situation?</div>
    <div class="choice-grid">
      <button class="choice selected" data-group="situation" data-value="phone" onclick="selectChoice(this)">
        <span class="choice-icon">📱</span><span class="choice-name">Phone</span><span class="choice-description">Phone only</span>
      </button>
      <button class="choice" data-group="situation" data-value="inside" onclick="selectChoice(this)">
        <span class="choice-icon">🏠</span><span class="choice-name">Inside</span><span class="choice-description">Home base</span>
      </button>
      <button class="choice" data-group="situation" data-value="outside" onclick="selectChoice(this)">
        <span class="choice-icon">🌳</span><span class="choice-name">Outside</span><span class="choice-description">Fresh air</span>
      </button>
      <button class="choice" data-group="situation" data-value="alone" onclick="selectChoice(this)">
        <span class="choice-icon">👤</span><span class="choice-name">Alone</span><span class="choice-description">Just me</span>
      </button>
      <button class="choice" data-group="situation" data-value="people" onclick="selectChoice(this)">
        <span class="choice-icon">👥</span><span class="choice-name">People</span><span class="choice-description">Not alone</span>
      </button>
      <button class="choice" data-group="situation" data-value="broke" onclick="selectChoice(this)">
        <span class="choice-icon">💸</span><span class="choice-name">Broke</span><span class="choice-description">$0 required</span>
      </button>
      <button class="choice" data-group="situation" data-value="lowEnergy" onclick="selectChoice(this)">
        <span class="choice-icon">🪫</span><span class="choice-name">Low Energy</span><span class="choice-description">Bare minimum</span>
      </button>
      <button class="choice" data-group="situation" data-value="fiveMinutes" onclick="selectChoice(this)">
        <span class="choice-icon">⏱️</span><span class="choice-name">5 Minutes</span><span class="choice-description">Quick hit</span>
      </button>
    </div>
  </div>

  <div class="choice-section">
    <div class="choice-heading">🎯 What sounds good?</div>
    <div class="choice-grid">
      <button class="choice" data-group="category" data-value="create" onclick="selectChoice(this)">
        <span class="choice-icon">🎨</span><span class="choice-name">Create</span><span class="choice-description">Make stuff</span>
      </button>
      <button class="choice" data-group="category" data-value="laugh" onclick="selectChoice(this)">
        <span class="choice-icon">😂</span><span class="choice-name">Laugh</span><span class="choice-description">Be ridiculous</span>
      </button>
      <button class="choice" data-group="category" data-value="music" onclick="selectChoice(this)">
        <span class="choice-icon">🎵</span><span class="choice-name">Music</span><span class="choice-description">Soundtrack me</span>
      </button>
      <button class="choice" data-group="category" data-value="watch" onclick="selectChoice(this)">
        <span class="choice-icon">📺</span><span class="choice-name">Watch</span><span class="choice-description">Put something on</span>
      </button>
      <button class="choice" data-group="category" data-value="learn" onclick="selectChoice(this)">
        <span class="choice-icon">🧠</span><span class="choice-name">Learn</span><span class="choice-description">Rabbit hole</span>
      </button>
      <button class="choice" data-group="category" data-value="play" onclick="selectChoice(this)">
        <span class="choice-icon">🎮</span><span class="choice-name">Play</span><span class="choice-description">Game time</span>
      </button>
      <button class="choice" data-group="category" data-value="nostalgia" onclick="selectChoice(this)">
        <span class="choice-icon">🕰️</span><span class="choice-name">Nostalgia</span><span class="choice-description">Take me back</span>
      </button>
      <button class="choice" data-group="category" data-value="social" onclick="selectChoice(this)">
        <span class="choice-icon">🗣️</span><span class="choice-name">Social</span><span class="choice-description">Interact</span>
      </button>
