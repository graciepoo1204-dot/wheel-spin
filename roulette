function getReelForCategory(category) {
  const match = reelsData[category] || reelsData.default;
  return {
    title: match.title,
    url: `https://www.youtube.com/results?search_query=${encodeURIComponent(match.query)}`
  };
}

function selectChoice(button) {
  const group = button.dataset.group;
  const value = button.dataset.value;
  const isSelected = button.classList.contains("selected");
  const current = selected[group];
  if (isSelected) {
    if (current.length <= 1) return;
    button.classList.remove("selected");
    selected[group] = current.filter(v => v !== value);
  } else {
    button.classList.add("selected");
    selected[group] = [...current, value];
  }
  if (group === "category") {
    if (value === "any" && selected.category.includes("any")) {
      selected.category = ["any"];
      document.querySelectorAll('.choice[data-group="category"]').forEach(btn => {
        btn.classList.toggle("selected", btn.dataset.value === "any");
      });
    } else if (value !== "any" && selected.category.includes("any")) {
      selected.category = selected.category.filter(v => v !== "any");
      document.querySelectorAll('.choice[data-group="category"][data-value="any"]').forEach(btn => {
        btn.classList.remove("selected");
      });
    }
  }
}

function getEligibleActivities(ignoreFilters = false) {
  if (ignoreFilters) return [...activities];
  const brains = selected.brain;
  const situations = selected.situation;
  const categories = selected.category;
  let results = activities.filter(activity => {
    const brainMatch = brains.some(b => activity.brain.includes(b));
    const situationMatch = situations.some(s => activity.situation.includes(s));
    const categoryMatch = categories.includes("any") || categories.some(c => activity.categories.includes(c));
    return brainMatch && situationMatch && categoryMatch;
  });
  if (results.length === 0) {
    results = activities.filter(activity => {
      return categories.includes("any") || categories.some(c => activity.categories.includes(c));
    });
  }
  if (results.length === 0) {
    results = activities.filter(activity => brains.some(b => activity.brain.includes(b)));
  }
  if (results.length === 0) results = [...activities];
  return results;
}

function createGeneratorActivity(category) {
  const list = generators[category];
  if (!list || !list.length) return null;
  const item = list[Math.floor(Math.random() * list.length)];
  return { id: "generator-" + Date.now(), title: item[0], emoji: item[1], desc: "This one came straight from the activity generator.", categories: [category], character: item[1] };
}

function chooseActivity(ignoreFilters = false) {
  const eligible = getEligibleActivities(ignoreFilters);
  const cats = selected.category.filter(c => c !== "any");
  if (!ignoreFilters && cats.length > 0 && Math.random() < 0.28) {
    const pick = cats[Math.floor(Math.random() * cats.length)];
    if (generators[pick]) return createGeneratorActivity(pick);
  }
  return eligible[Math.floor(Math.random() * eligible.length)];
}

const wheelCategories = ["create","laugh","music","watch","learn","play","nostalgia","social","chaos","mystery"];

function getWheelCategory(activity) {
  const cats = selected.category.filter(c => c !== "any" && c !== "chaos");
  if (cats.length > 0) return cats[Math.floor(Math.random() * cats.length)];
  if (activity.categories && activity.categories.length) {
    const usable = activity.categories.filter(cat => wheelCategories.includes(cat));
    if (usable.length) return usable[Math.floor(Math.random() * usable.length)];
  }
  return wheelCategories[Math.floor(Math.random() * wheelCategories.length)];
}

function spinWheelTo(category) {
  const index = wheelCategories.indexOf(category);
  const slice = 36;
  const targetCenter = index * slice + slice / 2;
  const extraSpins = 360 * (4 + Math.floor(Math.random() * 2));
  const target = extraSpins + (360 - targetCenter);
  currentRotation += target;
  document.getElementById("wheel").style.transform = `rotate(${currentRotation}deg)`;
}

function spinRoulette(quick = false) {
  if (spinning) return;
  spinning = true;
  const button = document.getElementById("spinButton");
  const status = document.getElementById("wheelStatus");
  const result = document.getElementById("result");
  result.classList.remove("show");
  if (button) button.disabled = true;
  
  const activity = chooseActivity(quick);
  currentActivity = activity;
  let category = getWheelCategory(activity);
  if (!quick && selected.category.includes("any") && Math.random() < .10) category = "mystery";
  status.textContent = "🎡 The wheel is deciding your fate...";
  
  spinWheelTo(category);
  
  setTimeout(() => {
    showResult(activity, category);
    spinning = false;
    if (button) button.disabled = false;
    status.textContent = `It landed on ${category.toUpperCase()}!`;
    streak++;
    localStorage.setItem("boredomRouletteStreak", streak);
    updateStreakDisplay();
    confetti();
  }, 3100);
}

function quickSpin() { spinRoulette(true); }

function showResult(activity, category) {
  const result = document.getElementById("result");
  document.getElementById("resultCharacter").textContent = activity.character || activity.emoji || "🎲";
  document.getElementById("resultTitle").textContent = activity.title;
  document.getElementById("resultDesc").textContent = activity.desc;
  document.getElementById("resultCategory").textContent = category.toUpperCase();
  
  const reel = getReelForCategory(category);
  document.getElementById("reelTitleText").textContent = reel.title;
  document.getElementById("reelLinkBtn").href = reel.url;
  
  result.classList.add("show");
  updateSaveButton();
  
  setTimeout(() => {
    result.scrollIntoView({ behavior: "smooth", block: "center" });
  }, 100);
}

function saveCurrent() {
  if (!currentActivity) return;
  const exists = saved.some(item => item.id === currentActivity.id);
  if (!exists) {
    saved.push(currentActivity);
  } else {
    saved = saved.filter(item => item.id !== currentActivity.id);
  }
  localStorage.setItem("boredomRouletteSaved", JSON.stringify(saved));
  updateSaveButton();
  renderSaved();
}

function updateSaveButton() {
  const button = document.getElementById("saveButton");
  if (!currentActivity || !button) return;
  const exists = saved.some(item => item.id === currentActivity.id);
  button.classList.toggle("saved", exists);
  button.textContent = exists ? "⭐ Saved" : "⭐ Save";
}

function renderSaved() {
  const container = document.getElementById("savedList");
  if (!container) return;
  if (!saved.length) {
    container.innerHTML = `<div class="saved-empty">⭐ Nothing saved yet.<br><br>Spin the wheel and save the activities you actually want to do.</div>`;
    return;
  }
  container.innerHTML = saved.map((item, index) => `
    <div class="saved-item">
      <div class="saved-emoji">${item.emoji || item.character || "🎲"}</div>
      <div class="saved-info">
        <div class="saved-title">${escapeHTML(item.title)}</div>
        <div class="saved-desc">${escapeHTML(item.desc)}</div>
      </div>
      <button class="delete-save" onclick="deleteSaved(${index})" title="Remove">✕</button>
    </div>
  `).join("");
}

function deleteSaved(index) {
  saved.splice(index, 1);
  localStorage.setItem("boredomRouletteSaved", JSON.stringify(saved));
  renderSaved();
  updateSaveButton();
}

function showSection(id, button) {
  document.querySelectorAll(".section").forEach(s => s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
  button.classList.add("active");
  if (id === "saved") renderSaved();
}

