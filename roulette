function setTheme(name) {
  const theme = themes[name];
  if (!theme) return;
  const root = document.documentElement;
  Object.entries(theme).forEach(([key, value]) => {
    if (key !== 'name') root.style.setProperty(`--${key}`, value);
  });
  
  document.body.style.background = theme.bgGradient;
  document.body.style.backgroundSize = "400% 400%";
  root.style.setProperty('--orb1', theme.orb1);
  root.style.setProperty('--orb2', theme.orb2);
  
  document.body.className = `theme-${theme.name}`;
  
  localStorage.setItem("boredomRouletteTheme", name);
  document.querySelectorAll(".theme-btn").forEach(btn => {
    btn.classList.toggle("active-theme", btn.dataset.theme === name);
  });
  document.getElementById("themePanel").classList.remove("open");
}

function toggleThemePanel() {
  document.getElementById("themePanel").classList.toggle("open");
}

function loadTheme() {
  const savedTheme = localStorage.getItem("boredomRouletteTheme") || "arcade";
  setTheme(savedTheme);
}

function confetti() {
  for (let i = 0; i < 40; i++) {
    const piece = document.createElement("div");
    piece.className = "confetti";
    piece.style.left = Math.random() * 100 + "vw";
    piece.style.top = (-10 - Math.random() * 20) + "px";
    piece.style.background = ["var(--accent)", "var(--accent2)", "var(--accent3)"][Math.floor(Math.random() * 3)];
    piece.style.transform = `rotate(${Math.random() * 360}deg)`;
    piece.style.animationDuration = (1.1 + Math.random() * 1.2) + "s";
    document.body.appendChild(piece);
    setTimeout(() => piece.remove(), 2500);
  }
}

function escapeHTML(text) {
  const div = document.createElement("div");
  div.textContent = text || "";
  return div.innerHTML;
}

